<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:orientation="vertical" android:padding="16dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:text="انبار من" android:textStyle="bold" android:textSize="28sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/settingsBtn" android:text="⚙" android:contentDescription="تنظیمات" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <EditText android:id="@+id/search" android:hint="🔍 جستجوی نام، بارکد یا دسته‌بندی" android:singleLine="true" android:imeOptions="actionSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <Button android:id="@+id/allBtn" android:text="همه" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/nearBtn" android:text="🟠 نزدیک" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/expiredBtn" android:text="🔴 منقضی" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
        <TextView android:id="@+id/expiredCount" android:text="🔴 0 منقضی" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/nearCount" android:text="🟠 0 نزدیک" android:gravity="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
        <LinearLayout android:id="@+id/list" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>
    <Button android:id="@+id/addBtn" android:text="＋ افزودن کالا" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
